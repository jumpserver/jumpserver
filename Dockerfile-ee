ARG VERSION=dev
ARG MODELS_TAG=latest
FROM jumpserver/gmssl:3.1.1-trixie AS gmssl-builder

FROM registry.fit2cloud.com/jumpserver/core-models:${MODELS_TAG} AS build-models
FROM registry.fit2cloud.com/jumpserver/xpack:${VERSION} AS build-xpack
FROM jumpserver/core:${VERSION}-ce

ARG INSIGHTFACE_MODEL_ROOT=/root/.insightface/models
ENV INSIGHTFACE_MODEL_ROOT=${INSIGHTFACE_MODEL_ROOT}

COPY requirements/download_face_models.py /opt/jumpserver/requirements/download_face_models.py

# Copy in one layer, preserving both supported model-root directory layouts.
RUN --mount=type=bind,from=build-models,source=/root/.insightface/models,target=/tmp/insightface-models \
    set -ex \
    && python -c 'import os, shutil, sys; from pathlib import Path; \
sys.path.insert(0, "/opt/jumpserver/requirements"); \
from download_face_models import model_directory; \
shutil.copytree("/tmp/insightface-models", model_directory(Path(os.environ["INSIGHTFACE_MODEL_ROOT"])).parent, dirs_exist_ok=True)' \
    && python /opt/jumpserver/requirements/download_face_models.py \
        --model-root "${INSIGHTFACE_MODEL_ROOT}" \
        --check

COPY --from=build-xpack /opt/xpack /opt/jumpserver/apps/xpack

ARG TOOLS="                           \
        g++                           \
        iputils-ping                  \
        netcat-openbsd                \
        telnet"

ARG FACE_RUNTIME_DEPENDENCIES="       \
        libgl1                        \
        libglib2.0-0t64"

RUN set -ex \
    && apt-get update \
    && apt-get -y install --no-install-recommends ${TOOLS} ${FACE_RUNTIME_DEPENDENCIES} \
    && apt-get clean all \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/jumpserver

ARG PIP_MIRROR=https://pypi.org/simple

RUN set -ex \
    && uv pip install -i${PIP_MIRROR} --extra-index-url https://pypi.org/simple/ --group xpack \
    && python -c "import cv2" \
    && rm -rf /root/.cache/

COPY --from=gmssl-builder /usr/local/lib/libgmssl.so* /usr/local/lib/
COPY --from=gmssl-builder /usr/local/include/gmssl /usr/local/include/gmssl
COPY --from=gmssl-builder /usr/local/bin/gmssl /usr/local/bin/gmssl

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf \
    && ldconfig
