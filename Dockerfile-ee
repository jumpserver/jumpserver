ARG VERSION=dev
FROM jumpserver/gmssl:3.1.1-trixie AS gmssl-builder

FROM registry.fit2cloud.com/jumpserver/xpack:${VERSION} AS build-xpack
FROM jumpserver/core:${VERSION}-ce

ARG INSIGHTFACE_MODEL_ROOT=/root/.insightface/models
ARG INSIGHTFACE_MODEL_URL=https://github.com/deepinsight/insightface/releases/download/v0.7/buffalo_l.zip
ENV INSIGHTFACE_MODEL_ROOT=${INSIGHTFACE_MODEL_ROOT}

COPY requirements/download_face_models.py /opt/jumpserver/requirements/download_face_models.py

RUN set -ex \
    && python /opt/jumpserver/requirements/download_face_models.py \
        --model-root "${INSIGHTFACE_MODEL_ROOT}" \
        --url "${INSIGHTFACE_MODEL_URL}" \
    && python /opt/jumpserver/requirements/download_face_models.py \
        --model-root "${INSIGHTFACE_MODEL_ROOT}" \
        --check \
    && rm -f "${INSIGHTFACE_MODEL_ROOT}/buffalo_l.zip"

COPY --from=build-xpack /opt/xpack /opt/jumpserver/apps/xpack

ARG TOOLS="                           \
        g++                           \
        iputils-ping                  \
        netcat-openbsd                \
        telnet"

RUN set -ex \
    && apt-get update \
    && apt-get -y install --no-install-recommends ${TOOLS} \
    && apt-get clean all \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/jumpserver

ARG PIP_MIRROR=https://pypi.org/simple

RUN set -ex \
    && uv pip install -i${PIP_MIRROR} --group xpack \
    && rm -rf /root/.cache/

COPY --from=gmssl-builder /usr/local/lib/libgmssl.so* /usr/local/lib/
COPY --from=gmssl-builder /usr/local/include/gmssl /usr/local/include/gmssl
COPY --from=gmssl-builder /usr/local/bin/gmssl /usr/local/bin/gmssl

RUN echo "/usr/local/lib" > /etc/ld.so.conf.d/local-lib.conf \
    && ldconfig
