"attrs <- SEP -> ID không hợp lệ, cần phải là danh sách <- SEP -> Trường này "
"là bắt buộc. <- SEP -> Thuộc tính không hợp lệ, cần phải là danh sách dict "
"<- SEP -> Thuộc tính không hợp lệ, phải có tên và giá trị <- SEP -> Bỏ qua "
"<- SEP -> Thời gian bỏ qua <- SEP -> Người cập nhật cuối cùng."

