msgid "Only exist user login"
msgstr "Connexion réservée aux utilisateurs existants"

#: settings/serializers/security.py:113
msgid ""
"If enabled, non-existent users will not be allowed to log in; if disabled, "
"users of other authentication methods except local authentication methods "
"are allowed to log in and automatically create users (if the user does not "
"exist)"
msgstr ""
"Si activé, les utilisateurs inexistants ne pourront pas se connecter ; si "
"désactivé, les utilisateurs d'autres méthodes d'authentification que les "
"méthodes locales sont autorisés à se connecter et à créer automatiquement "
"des utilisateurs (si l'utilisateur n'existe pas)"

