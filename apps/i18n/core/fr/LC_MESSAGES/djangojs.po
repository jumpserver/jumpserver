#: static/js/jumpserver.js:267
msgid "Update is successful!"
msgstr "Mise à jour réussie !"

#: static/js/jumpserver.js:269
msgid "An unknown error occurred while updating.."
msgstr "Une erreur inconnue est survenue lors de la mise à jour"

#: static/js/jumpserver.js:342
msgid "Not found"
msgstr "Introuvable"

#: static/js/jumpserver.js:344
msgid "Server error"
msgstr "Erreur serveur"

#: static/js/jumpserver.js:346 static/js/jumpserver.js:384
#: static/js/jumpserver.js:386
msgid "Error"
msgstr "Erreur"

#: static/js/jumpserver.js:352 static/js/jumpserver.js:393
msgid "Delete the success"
msgstr "Suppression réussie"

#: static/js/jumpserver.js:359
msgid "Are you sure about deleting it?"
msgstr "Voulez-vous vraiment le supprimer ?"

#: static/js/jumpserver.js:363 static/js/jumpserver.js:404
msgid "Cancel"
msgstr "Annuler"

#: static/js/jumpserver.js:365 static/js/jumpserver.js:406
msgid "Confirm"
msgstr "Confirmer"

#: static/js/jumpserver.js:384
msgid ""
"The organization contains undeleted information. Please try again after "
"deleting"
msgstr ""
"L'organisation contient des informations non supprimées. Veuillez "
"réessayer après les avoir supprimées"

#: static/js/jumpserver.js:386
msgid ""
"Do not perform this operation under this organization. Try again after "
"switching to another organization"
msgstr ""
"N'effectuez pas cette opération dans cette organisation. Réessayez après "
"être passé à une autre organisation"

#: static/js/jumpserver.js:400
msgid ""
"Please ensure that the following information in the organization has been "
"deleted"
msgstr ""
"Veuillez vous assurer que les informations suivantes de l'organisation ont "
"bien été supprimées"

#: static/js/jumpserver.js:401
msgid ""
"User list、User group、Asset list、Domain list、Admin user、System "
"user、Labels、Asset permission"
msgstr ""
"Liste des utilisateurs, groupes d'utilisateurs, liste des actifs, liste "
"des domaines, utilisateur privilégié, utilisateur système, étiquettes, "
"règles d'autorisation des actifs"

#: static/js/jumpserver.js:650
msgid "Unknown error occur"
msgstr "Une erreur inconnue est survenue"

#: static/js/jumpserver.js:902
msgid "Password minimum length {N} bits"
msgstr "Longueur minimale du mot de passe : {N} caractères"

#: static/js/jumpserver.js:903
msgid "Must contain capital letters"
msgstr "Doit contenir des lettres majuscules"

#: static/js/jumpserver.js:904
msgid "Must contain lowercase letters"
msgstr "Doit contenir des lettres minuscules"

#: static/js/jumpserver.js:905
msgid "Must contain numeric characters"
msgstr "Doit contenir des caractères numériques"

#: static/js/jumpserver.js:906
msgid "Must contain special characters"
msgstr "Doit contenir des caractères spéciaux"

msgid "Queued: waiting for an available ansible worker."
msgstr "En file d'attente : en attente d'un worker Ansible disponible."

msgid "Running: worker has accepted the task and is preparing execution logs."
msgstr ""
"En cours : le worker a accepté la tâche et prépare les journaux "
"d'exécution."

msgid "Log unavailable or the log directory is not shared."
msgstr "Journal indisponible ou le répertoire de journaux n'est pas partagé."
